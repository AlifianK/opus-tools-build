{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/clang-lto.toolchain.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "latest",
      "inherits": "base",
      "displayName": "latest (master of every repo), -march=native",
      "binaryDir": "${sourceDir}/build/latest",
      "cacheVariables": {
        "OPUSBUILD_SOURCE_DIR": "${sourceDir}/src",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/latest"
      }
    },
    {
      "name": "stable",
      "inherits": "base",
      "displayName": "stable (newest release tag of every repo), -march=native",
      "binaryDir": "${sourceDir}/build/stable",
      "cacheVariables": {
        "OPUSBUILD_SOURCE_DIR": "${sourceDir}/src-stable",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/stable"
      }
    },
    {
      "name": "latest-portable",
      "inherits": "latest",
      "displayName": "latest, x86-64-v2 (runs on other machines)",
      "binaryDir": "${sourceDir}/build/latest-portable",
      "cacheVariables": {
        "OPUSBUILD_NATIVE": "OFF",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/latest-portable"
      }
    },
    {
      "name": "stable-portable",
      "inherits": "stable",
      "displayName": "stable, x86-64-v2 (runs on other machines)",
      "binaryDir": "${sourceDir}/build/stable-portable",
      "cacheVariables": {
        "OPUSBUILD_NATIVE": "OFF",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/stable-portable"
      }
    }
  ],
  "buildPresets": [
    { "name": "latest",          "configurePreset": "latest",          "targets": ["install"] },
    { "name": "stable",          "configurePreset": "stable",          "targets": ["install"] },
    { "name": "latest-portable", "configurePreset": "latest-portable", "targets": ["install"] },
    { "name": "stable-portable", "configurePreset": "stable-portable", "targets": ["install"] }
  ]
}
